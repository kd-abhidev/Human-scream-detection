<MainWindow>:
    NavigationLayout:

        ScreenManager:

            Screen:
                name: "main"

                BoxLayout:
                    orientation: "vertical"

                    MDToolbar:
                        title: "Scream Detection"
                        elevation: 10
                        right_action_items: [["alert-decagram", lambda x: app.show_alert_dialog()]]

                    BoxLayout:
                        padding: 40
                        spacing: 40

                        MDCard:
                            orientation: "vertical"
                            padding: 20
                            spacing: 20
                            radius: [20]

                            ImageButton:
                                source: "resources/icons/microphone.png"
                                size_hint: None, None
                                size: 120,120
                                pos_hint: {"center_x": .5}
                                on_release: app.mainscreen_to_recscreen()

                            MDLabel:
                                text: "Record Audio"
                                halign: "center"

                        MDCard:
                            orientation: "vertical"
                            padding: 20
                            spacing: 20
                            radius: [20]

                            ImageButton:
                                source: "resources/icons/database.png"
                                size_hint: None, None
                                size: 120,120
                                pos_hint: {"center_x": .5}
                                on_release: app.mainscreen_to_internalstoragescreen()

                            MDLabel:
                                text: "Add From Storage"
                                halign: "center"

        MDNavigationDrawer:
            id: nav_drawer
            type: "standard"

            BoxLayout:
                orientation: "vertical"

                MDToolbar:
                    title: "Options"
                    elevation: 10

                MDList:

                    OneLineListItem:
                        text: "Help"
                        on_release: app.mainscreen_to_helpscreen()

                    OneLineListItem:
                        text: "Team"
                        on_release: app.mainscreen_to_teamscreen()

                Widget

                MDLabel:
                    text: "v1.0"
                    halign: "center"


<PopupWarning>:
    label_of_emergency: label_of_emergency

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 20

        Label:
            id: label_of_emergency
            text: ""
            markup: True
            halign: "center"

        Button:
            text: "Cancel"
            size_hint: 0.5, 0.15
            pos_hint: {"center_x": .5}
            on_press: app.close_popup()

        Button:
            text: "OK"
            size_hint: 0.5, 0.15
            pos_hint: {"center_x": .5}
            on_press: app.close_popup()


<AudioRecWindow>:
    mic_button: mic_button

    BoxLayout:
        orientation: "vertical"

        MDToolbar:
            title: "Record Audio"
            elevation: 10
            right_action_items: [["keyboard-backspace", lambda x: app.recscreen_to_mainscreen()]]

        BoxLayout:
            orientation: "vertical"
            padding: 40
            spacing: 40

            ImageButton:
                id: mic_button
                source: "resources/icons/micoff.png"
                size_hint: None, None
                size: 150,150
                pos_hint: {"center_x": .5}
                on_release: app.mic_clicked()

            MDRectangleFlatButton:
                text: "Process"
                pos_hint: {"center_x": .5}
                on_release: app.process_the_sound()


<InternalStorageWindow>:

    BoxLayout:
        orientation: "vertical"

        MDToolbar:
            title: "Select Audio"
            elevation: 10
            right_action_items: [["keyboard-backspace", lambda x: app.internalstoragescreen_to_mainscreen()]]

        BoxLayout:
            orientation: "vertical"
            padding: 40
            spacing: 40

            ImageButton:
                source: "resources/icons/plus.png"
                size_hint: None, None
                size: 150,150
                pos_hint: {"center_x": .5}
                on_release: app.internalstoragescreen_to_fileloader()

            MDRectangleFlatButton:
                text: "Process"
                pos_hint: {"center_x": .5}
                on_release: app.process_the_sound()


<FileLoader>:
    filechooser: filechooser

    BoxLayout:
        orientation: "vertical"

        FileChooserListView:
            id: filechooser
            path: "."
            multiselect: False

        BoxLayout:
            size_hint_y: None
            height: 40
            padding: 10
            spacing: 10

            Button:
                text: "Cancel"
                on_release: app.fileloaderscreen_to_internalstoragescreen()

            Button:
                text: "Load"
                on_release: app.loadfile(filechooser.path, filechooser.selection)


<HelpWindow>:

    BoxLayout:
        orientation: "vertical"

        MDToolbar:
            title: "Help"
            elevation: 10
            right_action_items: [["keyboard-backspace", lambda x: app.backforcommonscreens()]]

        ScrollView:

            MDLabel:
                padding: 30,30
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: "left"
                text:
                    "• Detects human scream or cry in audio files\n"
                    "• Accepts WAV audio files\n"
                    "• Record audio inside the application\n"
                    "• Process stored audio files"


